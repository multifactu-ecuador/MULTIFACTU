{
  "name": "multifactu-supabase",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w client",
    "test": "node --test tests/*.test.ts",
    "test:server": "node --test --experimental-strip-types server/tests/*.test.ts",
    "test:sql": "node tests/database.mjs",
    "check:edge": "deno check supabase/functions/sri-procesar/index.ts supabase/functions/planes-pago/index.ts supabase/functions/notas-procesar/index.ts supabase/functions/procesar-programadas/index.ts supabase/functions/generar-ride/index.ts",
    "typecheck:server": "tsc -p server/tsconfig.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.6.4",
    "@types/node-forge": "^1.3.14",
    "deno": "^2.9.6",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@xmldom/xmldom": "^0.8.15",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "xml-crypto": "6.1.1"
  }
}
