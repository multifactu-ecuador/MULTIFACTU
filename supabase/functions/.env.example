# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY se proveen en el entorno de Supabase.
SRI_WEBHOOK_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
SRI_MODE=simulation
# Para emisión real: SRI_MODE=real (usa ruta_p12 en Storage + contraseña cifrada en Vault vía RPC leer_p12_password)
# Cambiar a error permite probar rechazo; no depende de un campo enviado por el cliente.
SRI_SIMULATION_RESULT=authorized
# APP_ORIGIN admite VARIOS orígenes separados por coma (transición de
# dominio): el primero es el primario (base de URLs de retorno tipo PayPal).
APP_ORIGIN=http://localhost:5173
PAYMENTS_MODE=demo
# Suscripción automática de planes con PayPal: credenciales de la app de
# PayPal (Dashboard > My Apps & Credentials). PAYPAL_MODE=sandbox por
# defecto; PAYPAL_MODE=live sólo con credenciales de producción.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PLAN_IVA_RATE=15
