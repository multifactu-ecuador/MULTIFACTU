# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY se proveen en el entorno de Supabase.
SRI_WEBHOOK_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
