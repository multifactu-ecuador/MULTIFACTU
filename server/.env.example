# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SUPABASE_URL=
# Server-only service role key. Never prefix it with VITE_ and never deploy it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ character server-to-server token used only by the Edge worker.
FISCAL_SIGNER_INTERNAL_TOKEN=
