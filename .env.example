# Variables locales de desarrollo (este archivo es la plantilla; los valores
# reales van en .env.local, que está en .gitignore).
#
# Cuenta SANDBOX de Paddle — usada por scripts locales como
# scripts/seed-paddle-catalog.ts y por la function paddle-portal
# (PADDLE_API_KEY es secret: viaja sólo en el servidor, jamás en VITE_*).
# Créala en https://sandbox-vendors.paddle.com/authentication-v2 con los
# permisos mínimos product.write y price.write. Debe empezar por pdl_sdbx_.
PADDLE_API_KEY=pdl_sdbx_reemplazame

# Cuenta LIVE de Paddle — SÓLO para scripts locales de migración
# (scripts/paddle-live-migrate.ts); nunca va a Supabase secrets ni a Vercel.
# Créala en https://vendors.paddle.com (Settings > API keys). Empieza por
# pdl_live_. El script sólo CREA entidades nuevas en live (aditivo).
PADDLE_LIVE_API_KEY=pdl_live_reemplazame

# ── Paddle servidor (Edge Functions paddle-webhook / paddle-portal) ─────────
# Entorno del SDK de servidor: "sandbox" | "production". No se asume: si
# falta, la function responde 503 en lugar de operar en la cuenta equivocada.
# En Supabase: supabase secrets set PADDLE_ENVIRONMENT=...
PADDLE_ENVIRONMENT=sandbox
# Secreto de FIRMA de la notificación de Paddle (Events > Notifications >
# endpoint secret; empieza por pdl_ntfset_). Es distinto de la API key.
# Sin él, paddle-webhook responde 503 y Paddle reintenta hasta configurarlo.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_reemplazame

# ── Paddle en el cliente (Vite) — obligatorios para /precios ────────────────
# Nunca se asume un entorno: si falta alguna, la página muestra el error y no
# inicializa Paddle. En Vercel van en Project Settings > Environment Variables
# (se leen al construir); en local, en .env.local.
# Entorno: "sandbox" (pruebas) | "production" (cuenta live real).
VITE_PADDLE_ENVIRONMENT=sandbox
# Token de cliente (público). Sandbox = prefijo test_; live = prefijo live_.
# Se crea en Paddle > Developer tools > Client-side tokens.
VITE_PADDLE_CLIENT_TOKEN=test_reemplazame
